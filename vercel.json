{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/portal/admin/login", "destination": "/admin.html" },
    { "source": "/portal/admin/dashboard", "destination": "/admin.html" },
    { "source": "/portal/admin", "destination": "/admin.html" },
    { "source": "/portal/admin/(.*)", "destination": "/admin.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin.html", "destination": "/admin.html" },
    { "source": "/shopno001", "destination": "/shopno001/index.html" },
    { "source": "/shopno002", "destination": "/shopno002/index.html" },
    { "source": "/shopno003", "destination": "/shopno003/index.html" },
    { "source": "/shopno004", "destination": "/shopno004/index.html" },
    { "source": "/shopno005", "destination": "/shopno005/index.html" },
    { "source": "/shopno001/(.*)", "destination": "/shopno001/$1" },
    { "source": "/shopno002/(.*)", "destination": "/shopno002/$1" },
    { "source": "/shopno003/products", "destination": "/shopno003/products.html" },
    { "source": "/shopno004/products", "destination": "/shopno004/products.html" },
    { "source": "/shopno003/(.*)", "destination": "/shopno003/$1" },
    { "source": "/shopno004/(.*)", "destination": "/shopno004/$1" },
    { "source": "/shopno005/(.*)", "destination": "/shopno005/$1" }
  ],
  "headers": [
    {
      "source": "/(.*).(js|css|html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
